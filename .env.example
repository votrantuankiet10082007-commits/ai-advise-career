# =================================================================
# AI CAREER ADVISOR - ENVIRONMENT CONFIGURATION
# =================================================================

# Port for HTTP & REST API Server (Default: 8080)
PORT=8080

# =================================================================
# 🔑 API KEY CONFIGURATION (Choose Gemini or OpenAI)
# =================================================================

# 1. GOOGLE GEMINI API KEY (Khuyên dùng - Miễn phí & Nhanh)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. OPENAI API KEY (Lựa chọn thay thế)
# Lấy API Key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Cấu hình bổ sung
# Mặc định hỗ trợ chạy thử trong LAN. Khi deploy, đặt HOST=127.0.0.1.
# HOST=0.0.0.0
# PUBLIC_ORIGIN=http://localhost:8080
# DATABASE_DIR=database
# NODE_ENV=development
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=
PREMIUM_PRICE_T1_VND=50000
PREMIUM_PRICE_T2_VND=100000
PREMIUM_PRICE_T3_VND=200000

# Tùy chọn: đổi model nếu endpoint mặc định của mã gốc đã ngừng hỗ trợ.
GEMINI_MODEL=
OPENAI_MODEL=
